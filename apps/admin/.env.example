# Copiar a .env.local (nunca commitear .env.local — ya está en .gitignore)

# Proyecto de Supabase de PlenaPet (independiente del de VetShipping)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NUNCA prefijar con NEXT_PUBLIC_. El admin lo necesita para leer/
# escribir tablas internas (product_overrides, pricing_rules, etc.) que RLS
# bloquea para anon/authenticated.
SUPABASE_SERVICE_ROLE_KEY=
