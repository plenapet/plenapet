# Copiar a .env.local (nunca commitear .env.local — ya está en .gitignore)

# Proyecto de Supabase de PlenaPet (independiente del de VetShipping)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dominio real de producción, sin barra final (ej. https://plenapet.com).
# Usado por sitemap.xml, robots.txt y metadata (Open Graph/canonical).
NEXT_PUBLIC_SITE_URL=https://plenapet.com

# Server-only. NUNCA prefijar con NEXT_PUBLIC_ (se expondría al navegador).
# La usan las páginas de /admin (panel interno) para leer catálogo y pedidos
# sin las restricciones de RLS, y más adelante el checkout para crear pedidos
# server-side.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Proveedor de email transaccional (bienvenida, resultados de
# laboratorio publicados, nuevas recomendaciones de PlenaPet Health).
# Dominio plenapet.com verificado en Resend (2026-08-18).
RESEND_API_KEY=
EMAIL_FROM="PlenaPet <notificaciones@plenapet.com>"
