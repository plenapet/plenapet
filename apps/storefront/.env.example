# Copiar a .env.local (nunca commitear .env.local — ya está en .gitignore)

# Proyecto de Supabase de PlenaPet (independiente del de VetShipping)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dominio real de producción, sin barra final (ej. https://plenapet.co).
# Usado por sitemap.xml, robots.txt y metadata (Open Graph/canonical). Si no
# se define, cae a un placeholder — ver src/lib/site-url.ts.
NEXT_PUBLIC_SITE_URL=

# Server-only. NUNCA prefijar con NEXT_PUBLIC_ (se expondría al navegador).
# La usan las páginas de /admin (panel interno) para leer catálogo y pedidos
# sin las restricciones de RLS, y más adelante el checkout para crear pedidos
# server-side.
SUPABASE_SERVICE_ROLE_KEY=
